# ===============================================
# Variables d'environnement requises pour LOWA
# ===============================================

# STRIPE
# Obtenez vos clés sur https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_live_...  # ou pk_test_... pour le mode test
STRIPE_SECRET_KEY=sk_live_...  # ou sk_test_... pour le mode test

# PAYPAL (optionnel - pour la méthode PayPal)
# Obtenez vos clés sur https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_MODE=sandbox  # ou 'live' pour production

# ===============================================
# Instructions de configuration
# ===============================================

# 1. STRIPE (OBLIGATOIRE)
#    - Allez sur https://dashboard.stripe.com/
#    - Créez un compte Stripe (gratuit)
#    - Allez dans "Developers" > "API keys"
#    - Copiez votre clé publique (pk_...) et clé secrète (sk_...)
#    - Collez-les dans ce fichier

# 2. PAYPAL (OPTIONNEL)
#    - Allez sur https://developer.paypal.com/
#    - Créez un compte Developer
#    - Créez une application
#    - Copiez votre Client ID et Secret

# 3. Fichier .env.local (Vercel)
#    - Sur Vercel, utilisez les variables dans les settings du projet
#    - Settings > Environment Variables

# ===============================================
# Pour tester en local
# ===============================================
# 1. Créez un fichier .env.local
# 2. Copiez-y les variables ci-dessus
# 3. Installez dotenv: npm install dotenv
# 4. Chargez les variables dans votre code

